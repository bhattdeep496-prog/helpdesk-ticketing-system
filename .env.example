# Copy to .env and edit. Production me ye sab environment variables ki tarah set karo.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
SITE_URL=https://your-app.up.railway.app

# PostgreSQL (SQLite use hoga agar ye khali hai)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Real emails (khali chhodo to emails terminal me print honge)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Deskly Helpdesk <you@example.com>
